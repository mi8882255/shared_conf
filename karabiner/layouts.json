{
  "title": "shared_conf: раскладки и Caps Lock",
  "rules": [
    {
      "description": "shared_conf: fn отдельно → EN (в Windows App: Ctrl+Shift+1)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "apple_vendor_top_case_key_code": "keyboard_fn",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "apple_vendor_top_case_key_code": "keyboard_fn"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "1",
              "modifiers": [
                "left_control",
                "left_shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.rdc\\.macos$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "apple_vendor_top_case_key_code": "keyboard_fn",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "apple_vendor_top_case_key_code": "keyboard_fn"
            }
          ],
          "to_if_alone": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "fn",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "fn"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "1",
              "modifiers": [
                "left_control",
